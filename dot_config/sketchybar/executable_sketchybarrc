# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# Sits where the macOS menu bar would be, below normal windows (topmost=off).
# The real menu bar auto-hides and draws above this bar when revealed by moving
# the pointer to the top edge.
# 32 = the strip beside the notch that macOS keeps windows out of; Rectangle's
# top gap reserves the same strip on screens without a notch.
sketchybar --bar position=top height=32 blur_radius=30 color=0x40000000 topmost=off y_offset=0

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Desktop Indicators #####
# Native `space` items track macOS Mission Control desktops directly, so the bar
# always matches what macOS shows and each item follows its desktop's display.
# Clicking sends the Option+N "Switch to Desktop N" shortcut set up by
# run_onchange_after_macos-desktop.sh.
DESKTOP_KEYCODES=(18 19 20 21 23 22 26 28 25) # key codes for 1-9
for i in "${!DESKTOP_KEYCODES[@]}"; do
  sid="$((i + 1))"
  space=(
    space="$sid"
    label="$sid"
    label.font.size=14.0
    icon.drawing=off
    background.color=0x44ffffff
    background.corner_radius=5
    background.height=20
    background.drawing=off
    script="$PLUGIN_DIR/space.sh"
    click_script="osascript -e 'tell application \"System Events\" to key code ${DESKTOP_KEYCODES[i]} using option down'"
  )
  sketchybar --add space space."$sid" left \
             --set space."$sid" "${space[@]}" \
             --subscribe space."$sid" space_windows_change
done

##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock update_freq=10 icon=  script="$PLUGIN_DIR/clock.sh" display=1 \
           --set clock click_script="open -a 'Notion Calendar'" \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" display=1 \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" display=1 \
           --subscribe battery system_woke power_source_change \
           --add item vpn left \
           --set vpn update_freq=5 script="$PLUGIN_DIR/vpn.sh" display=1 \
           --add item network left \
           --set network update_freq=2 script="$PLUGIN_DIR/network.sh" display=1 \
           --add item wifi left \
           --set wifi update_freq=5 script="$PLUGIN_DIR/wifi.sh" display=1 \
           --subscribe wifi wifi_change system_woke

